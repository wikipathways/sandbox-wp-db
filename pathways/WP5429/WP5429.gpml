<?xml version="1.0" encoding="UTF-8"?>
<Pathway Data-Source="WikiPathways" Last-Modified="20261119150524" Version="WP5429_r20261119150524" xmlns="http://pathvisio.org/GPML/2013a" Name="Aryl hydrocarbon receptor activation by dioxin" Author="[marvinm2]" Organism="Homo sapiens">
  <Graphics BoardWidth="760.0" BoardHeight="560.0" />
  <Comment Source="WikiPathways-description">The environmental contaminant 2,3,7,8-tetrachlorodibenzo-p-dioxin (TCDD) binds the aryl hydrocarbon receptor (AHR), which is held in the cytoplasm by HSP90 and the co-chaperone AIP. Ligand binding releases the receptor, which moves to the nucleus, dimerises with ARNT and induces the xenobiotic-metabolising enzymes CYP1A1 and CYP1B1 in human cells.</Comment>
  <BiopaxRef>ref1</BiopaxRef>

