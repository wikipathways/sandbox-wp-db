  <!-- Added in the revision: the AHR repressor and its negative feedback on ARNT. -->
  <DataNode TextLabel="AHRR" GraphId="d008" Type="GeneProduct">
    <Comment>AHR repressor; an AHR target gene that competes with AHR for ARNT.</Comment>
    <Graphics ZOrder="32768" CenterX="320.0" CenterY="480.0" Width="120.0" Height="34.0" Color="1a5276" />
    <Xref Database="Ensembl" ID="ENSG00000063438" />
  </DataNode>

  <!-- NQO1: a further AHR/ARNT target gene. -->
  <DataNode TextLabel="NQO1" GraphId="d009" Type="GeneProduct">
    <Comment>NAD(P)H quinone dehydrogenase 1; induced through the xenobiotic response element.</Comment>
