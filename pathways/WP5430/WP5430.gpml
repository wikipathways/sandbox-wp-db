<?xml version="1.0" encoding="UTF-8"?>
<Pathway Data-Source="WikiPathways" Last-Modified="20261120113535" Version="WP5430_r20261120143027" xmlns="http://pathvisio.org/GPML/2013a" Name="Aryl hydrocarbon receptor activation by dioxin" Author="[marvinm2]" Organism="Homo sapiens">
  <Graphics BoardWidth="760.0" BoardHeight="560.0" />
  <Comment Source="WikiPathways-description">The environmental contaminant 2,3,7,8-tetrachlorodibenzo-p-dioxin (TCDD) binds the aryl hydrocarbon receptor (AHR), which is held in the cytoplasm by HSP90 and the co-chaperone AIP. Ligand binding releases the receptor, which moves to the nucleus, dimerises with ARNT and induces the xenobiotic-metabolising enzymes CYP1A1, CYP1B1 and NQO1 and the repressor AHRR in human cells.</Comment>
  <BiopaxRef>ref1</BiopaxRef>
  <BiopaxRef>ref2</BiopaxRef>

  <DataNode TextLabel="TCDD" GraphId="d001" Type="Metabolite">
    <Comment>2,3,7,8-tetrachlorodibenzo-p-dioxin, the prototypical high-affinity AHR ligand.</Comment>
    <Graphics ZOrder="32768" CenterX="190.0" CenterY="90.0" Width="120.0" Height="34.0" Color="0000ff" FillColor="ffffff" />
    <Xref Database="ChEBI" ID="CHEBI:28119" />
  </DataNode>

  <DataNode TextLabel="AHR" GraphId="d002" Type="GeneProduct" GroupRef="grp1">
